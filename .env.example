DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
SPOTIFY_CLIENT_ID="your_spotify_client_id"
SPOTIFY_CLIENT_SECRET="your_spotify_client_secret"
SPOTIFY_MARKET=DK
RESEND_API_KEY="re_example_key"
ALERT_EMAIL_TO="alerts@example.com"
ALERT_EMAIL_FROM="admin@example.com"
CRON_SECRET="replace-with-a-long-random-secret"

# Optional: override the Spotify OAuth callback URL (defaults to localhost for local dev)
# SPOTIFY_REDIRECT_URI="https://your-app.vercel.app/api/spotify/callback"

# Optional: enables AI-powered track replacement suggestions
# OPENAI_API_KEY="sk-..."
# OPENAI_SUGGESTION_MODEL="gpt-4o-mini"
